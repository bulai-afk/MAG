# Copy to `.env` in the repository root. Never commit `.env`.
# Local values below are placeholders for Docker Compose, not production secrets.

NODE_ENV=development
APP_URL=http://localhost:3000
WEB_PORT=3000
WORKER_HEALTH_PORT=3001
LOG_LEVEL=info

# Local Docker Compose credentials from compose.yaml. Replace before any shared environment.
# If 5432/6379 are busy, change POSTGRES_PUBLISH_PORT / REDIS_PUBLISH_PORT and the URLs below.
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
DATABASE_URL=postgres://mag:mag@localhost:5432/mag
REDIS_URL=redis://localhost:6379

# Generate a random string of at least 32 characters before running locally.
SESSION_SECRET=replace-me-with-a-random-32-byte-secret

# Object storage — optional until the import pipeline stage.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI provider — optional until the narratives stage. Do not put production keys here.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Email — optional until delivery. Do not put production SMTP credentials here.
EMAIL_PROVIDER=
EMAIL_FROM=

# Error tracking — optional.
SENTRY_DSN=

# Comma-separated feature flags. Empty is valid.
FEATURE_FLAGS=
