{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "env": [
        "NODE_ENV",
        "APP_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "SESSION_SECRET",
        "WEB_PORT",
        "WORKER_HEALTH_PORT"
      ]
    }
  }
}
